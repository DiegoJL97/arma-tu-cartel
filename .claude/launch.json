{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arma-tu-cartel",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\node.exe",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs'),path=require('path');let p=path.join(process.cwd(), req.url.split('?')[0]==='/'?'/index.html':req.url.split('?')[0]);const ext=path.extname(p).slice(1);const types={html:'text/html',css:'text/css',js:'application/javascript',webp:'image/webp',png:'image/png'};fs.readFile(p,(err,data)=>{if(err){res.writeHead(404);res.end('not found');return;}res.writeHead(200,{'Content-Type':types[ext]||'application/octet-stream'});res.end(data);});}).listen(8000, ()=>console.log('listening on 8000'))"],
      "port": 8000
    }
  ]
}
